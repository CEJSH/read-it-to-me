GEMINI_API_KEY=...

# Text-to-speech uses Gemini TTS on the same GEMINI_API_KEY above — no extra
# credentials needed. Optionally override the voice or model:
# GEMINI_TTS_VOICE=Kore     # others: Aoede, Leda, Puck, Charon, Zephyr, Fenrir
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- 보호자 루프 (선택; 없으면 루프 전체 비활성, 기존 동작 유지) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# GUARDIAN_ACCESS_KEY=      # /g 목록 접근 키 (아무 긴 랜덤 문자열)
# --- SMS (선택; 없으면 기록만 하고 문자 미발송) ---
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_PHONE=      # 솔라피에 사전 등록된 발신번호
